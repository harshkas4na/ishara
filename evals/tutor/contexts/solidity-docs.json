 "blocks": [
  {
   "id": "t0",
   "kind": "h",
   "text": "Solidity",
   "inView": true,
   "rect": {
    "x": 360,
    "y": 90,
    "w": 760,
    "h": 44
   }
  },
  {
   "id": "t1",
   "kind": "p",
   "text": "Solidity is an object-oriented, high-level language for implementing smart contracts. Smart contracts are programs that govern the behavior of accounts within the Ethereum state.",
   "inView": true,
   "rect": {
    "x": 360,
    "y": 160,
    "w": 760,
    "h": 44
   }
  },
  {
   "id": "t2",
   "kind": "p",
   "text": "Solidity is a curly-bracket language designed to target the Ethereum Virtual Machine (EVM). It is influenced by C++, Python, and JavaScript.",
   "inView": true,
   "rect": {
    "x": 360,
    "y": 230,
    "w": 760,
    "h": 44
   }
  },
  {
   "id": "t3",
   "kind": "p",
   "text": "Solidity is statically typed, supports inheritance, libraries, and complex user-defined types, among other features.",
   "inView": true,
   "rect": {
    "x": 360,
    "y": 300,
    "w": 760,
    "h": 44
   }
  },
  {
   "id": "t4",
   "kind": "p",
   "text": "With Solidity, you can create contracts for uses such as voting, crowdfunding, blind auctions, and multi-signature wallets.",
   "inView": true,
   "rect": {
    "x": 360,
    "y": 370,
    "w": 760,
    "h": 44
   }
  },
  {
   "id": "t5",
   "kind": "p",
   "text": "When deploying contracts, you should use the latest released version of Solidity. Apart from exceptional cases, only the latest version receives security fixes.",
   "inView": true,
   "rect": {
    "x": 360,
    "y": 440,
    "w": 760,
    "h": 44
   }
  },
  {
   "id": "t6",
   "kind": "p",
   "text": "Warning: The Solidity 0.8.x release introduced a lot of breaking changes. Make sure you read the full list.",
   "inView": true,
   "rect": {
    "x": 360,
    "y": 510,
    "w": 760,
    "h": 44
   }
  },
  {
   "id": "t7",
   "kind": "p",
   "text": "Ideas for improving Solidity or this documentation are always welcome, read our contributors guide for more details.",
   "inView": true,
   "rect": {
    "x": 360,
    "y": 580,
    "w": 760,
    "h": 44
   }
  },
  {
   "id": "t8",
   "kind": "p",
   "text": "Hint: You can download this documentation as PDF, HTML or Epub by clicking on the versions flyout menu in the bottom-left corner and selecting the preferred download format.",
   "inView": true,
   "rect": {
    "x": 360,
    "y": 650,
    "w": 760,
    "h": 44
   }
  }
 ],
