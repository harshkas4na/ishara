{
  "name": "ishara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Sealed screen tutor on 0G (working name)",
  "scripts": {
    "helper": "node helper/src/server.ts",
    "check": "node scripts/smoke.ts",
    "test": "node --test helper/test/*.test.ts",
    "desktop:build": "swiftc -O -swift-version 5 desktop/ishara-ax.swift -o desktop/ishara-ax && swiftc -O -swift-version 5 desktop/ishara-overlay.swift -o desktop/ishara-overlay && swiftc -O -swift-version 5 desktop/ishara-ptt.swift -o desktop/ishara-ptt",
    "desktop": "node scripts/desktop-demo.ts",
    "helper:desktop": "ISHARA_DESKTOP=1 ISHARA_DEV=1 node helper/src/server.ts",
    "helper:dev": "ISHARA_DEV=1 node helper/src/server.ts",
    "fake-router": "node test/fake-router/server.ts",
    "helper:fake": "ISHARA_ROUTER_URL=http://127.0.0.1:7791/v1 ISHARA_DEV=1 node helper/src/server.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "1.2.13",
    "ethers": "6.13.1",
    "solc": "0.8.26"
  }
}
