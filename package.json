    "helper:dev": "ISHARA_DEV=1 node helper/src/server.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "1.2.13",
    "ethers": "6.13.1",
    "solc": "0.8.26"
  }
}
