{
  "name": "ishara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Sealed screen tutor on 0G (working name)",
  "scripts": {
    "helper": "node helper/src/server.ts",
    "check": "node scripts/smoke.ts",
    "test": "node --test helper/test/*.test.ts",
